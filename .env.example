# GEMINI_API_KEY: enables /api/chat AI replies (optional)
# Without it, seed chats still work via the local bot.
GEMINI_API_KEY=

# APP_URL: public URL of this deployment
APP_URL=http://localhost:3000

# Cloudinary (optional). If unset, photos go to Firebase Storage.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Lipana M-Pesa (optional). If unset, payment is simulated for demos.
LIPANA_API_KEY=
LIPANA_PAYMENT_LINK_SLUG=
LIPANA_CALLBACK_URL=
